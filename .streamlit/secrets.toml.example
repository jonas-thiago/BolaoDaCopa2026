# Configuração do Supabase para o Streamlit Cloud
# Adicione estes valores no dashboard do Streamlit Cloud em "Secrets"
# Ou renomeie este arquivo para secrets.toml para desenvolvimento local (não suba o secrets.toml para o git!)

[connections.supabase]
SUPABASE_URL = "https://seu-projeto.supabase.co"
SUPABASE_KEY = "sua-anon-key"
